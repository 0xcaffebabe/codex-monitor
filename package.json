{
  "name": "codex-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, real-time window into local Codex sessions",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run check:architecture && tsc --noEmit && vite build && node scripts/build-server.mjs",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "client": "node --disable-warning=ExperimentalWarning dist/server.mjs --mode client",
    "server": "node --disable-warning=ExperimentalWarning dist/server.mjs --mode server",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "account": "tsx scripts/account.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.77.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.0.3",
    "node-pty": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.5.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
