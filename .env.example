# Copy to .env; start.ps1 loads these values as fallback without executing them.
# Priority: command-line parameters > process environment > .env > defaults.
# Client CLI: npm run client -- --server-url <url> --workspace-id <id> --client-key <key>
# Windows: start.cmd -Mode client -ServerUrl <url> -WorkspaceId <id> -ClientKey <key>
HOST=0.0.0.0
PORT=4317
# standalone: server + local client over encrypted WebSocket (default)
# server: web gateway only, no local Codex runtime
# client: outbound WebSocket client only, no public web port
MONITOR_MODE=standalone
# For client mode, copy these from Web > Manage workspaces > Add.
# Both machines keep the same fixed AES-256 key locally. It is never sent over ws.
# MONITOR_SERVER_URL=ws://server-address:4317
# MONITOR_WORKSPACE_ID=xxxxxxxx-xxxx-4xxx-8xxx-xxxxxxxxxxxx
# MONITOR_CLIENT_KEY=<43-character base64url key>
# Alternatively keep only the key in a private local file:
# MONITOR_CLIENT_KEY_FILE=D:\private\codex-monitor-client.key
# CODEX_HOME=C:\Users\your-name\.codex
# MONITOR_DATA_DIR=D:\private\codex-monitor
# Manual USD / million-token rates; changes apply without restarting.
# MONITOR_PRICING_FILE=D:\work\codex-monitor\config\model-pricing.json
# Explicit public origin(s), comma separated, for an HTTPS reverse proxy.
# MONITOR_ORIGINS=https://codex.example.com
# Native HTTPS (optional):
# MONITOR_HTTPS=true
# MONITOR_TLS_CERT=D:\certs\fullchain.pem
# MONITOR_TLS_KEY=D:\certs\privkey.pem
# Optional: select one desktop instance when multiple are running.
# MONITOR_CODEX_PIPE=\\.\pipe\codex-app-tools-<instance-id>
# Optional: override the bundled Codex executable used for goal RPCs.
# MONITOR_CODEX_CLI=C:\path\to\codex.exe
# Windows clients check the Codex desktop immediately and every 15 seconds.
# Launch a missing desktop automatically; at least 60 seconds between attempts.
# MONITOR_CODEX_AUTOSTART=false
# MONITOR_CODEX_CHECK_MS=15000
# Optional full GUI executable path for a nonstandard installation (not the CLI).
# MONITOR_CODEX_DESKTOP=C:\path\to\app\ChatGPT.exe
